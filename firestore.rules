rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Troque pelo UID real do dono antes de publicar.
    function ownerUid() {
      return 'OWNER_UID_PLACEHOLDER';
    }

    // Dono raiz: o UID acima. Não é um documento, então ninguém o remove pelo app.
    function isRoot() {
      return request.auth != null && request.auth.uid == ownerUid();
    }

    // Administrador: existe admins/{uid}. Dono raiz e administradores nomeiam administradores.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner() {
      return isRoot() || isAdmin();
    }

    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function canRead() {
      return isOwner() || isMember();
    }

    // Coleções só o dono escreve; dono e membros leem.
    match /people/{id} {
      allow read: if canRead();
      allow write: if isOwner();
    }
    match /projects/{id} {
      allow read: if canRead();
      allow write: if isOwner();
    }
    match /project_members/{id} {
      allow read: if canRead();
      allow write: if isOwner();
    }
    match /sprints/{id} {
      allow read: if canRead();
      allow write: if isOwner();
    }
    match /pages/{id} {
      allow read: if canRead();
      allow write: if isOwner();
    }

    // Membro só muda o status da tarefa.
    match /tasks/{id} {
      allow read: if canRead();
      allow create, delete: if isOwner();
      allow update: if isOwner()
        || (isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['todo', 'doing', 'done']);
    }

    // Membro só muda o done do item.
    match /task_items/{id} {
      allow read: if canRead();
      allow create, delete: if isOwner();
      allow update: if isOwner()
        || (isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])
          && request.resource.data.done is bool);
    }

    match /members/{uid} {
      allow read: if isOwner() || (request.auth != null && request.auth.uid == uid);
      allow write: if isOwner();
    }

    match /admins/{uid} {
      allow read: if isOwner() || (request.auth != null && request.auth.uid == uid);
      allow write: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
